# ═══════════════════════════════════════════════════════════════════════════
# SPX500 FORECASTING — ENVIRONMENT VARIABLES TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════
# 
# CRITICAL: Copy this file to .env and fill in real values
#           NEVER commit .env to version control
#
# Usage:
#   cp .env.example .env
#   nano .env  # Fill in your API keys
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ───────────────────────────────────────────────────────────────────────────
ENV=development
# Options: development, staging, production
# Controls which config/*.yaml files are loaded

DEBUG=true
# Enable verbose logging and debug output

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ───────────────────────────────────────────────────────────────────────────
# DATA SOURCES — PHASE 1 (FREE)
# ───────────────────────────────────────────────────────────────────────────

# FRED (Federal Reserve Economic Data)
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=badd567798eadfde0626ffd9090a8d98
FRED_RATE_LIMIT=120  # requests per minute (free tier)

# yfinance (No API key required, but uses Yahoo Finance)
# Rate limits: Be respectful, ~2000 requests/hour recommended
YFINANCE_RATE_LIMIT=2000

# ───────────────────────────────────────────────────────────────────────────
# DATA SOURCES — PHASE 2 (PAID)
# ───────────────────────────────────────────────────────────────────────────

# ORATS (Options Research & Technology Services)
# Paid subscription required: https://www.orats.com/
ORATS_API_KEY=your_orats_api_key_here
ORATS_BASE_URL=https://api.orats.com/datav2
ORATS_RATE_LIMIT=10  # requests per second (check your tier)

# Polygon.io (Stock & Options data)
# Paid subscription required: https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_BASE_URL=https://api.polygon.io
POLYGON_RATE_LIMIT=5  # requests per second (Basic tier)

# CBOE (Chicago Board Options Exchange)
# Some data is free, real-time requires subscription
CBOE_API_KEY=your_cboe_api_key_here
CBOE_WEBSOCKET_URL=wss://cdp.cboe.com/websocket

# ───────────────────────────────────────────────────────────────────────────
# DATABASE & STORAGE
# ───────────────────────────────────────────────────────────────────────────

# Local file paths (default: relative to project root)
DATA_ROOT=./data
RUNS_ROOT=./runs

# Optional: AWS S3 for cloud storage (Phase 7+)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=spx500-forecasting-data

# Optional: PostgreSQL for metadata (Phase 7+)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=spx500_metadata
# POSTGRES_USER=spx500_user
# POSTGRES_PASSWORD=your_postgres_password

# ───────────────────────────────────────────────────────────────────────────
# TRADING EXECUTION (PHASE 8)
# ───────────────────────────────────────────────────────────────────────────

# Interactive Brokers (Paper Trading)
# Account required: https://www.interactivebrokers.com/
# IBKR_ACCOUNT=DU123456  # Paper trading account
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497  # 7497 for paper, 7496 for live
# IBKR_CLIENT_ID=1

# Alpaca Markets (Paper Trading)
# Free paper trading: https://alpaca.markets/
# ALPACA_API_KEY=your_alpaca_api_key
# ALPACA_SECRET_KEY=your_alpaca_secret_key
# ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading

# ───────────────────────────────────────────────────────────────────────────
# MONITORING & ALERTS (PHASE 9)
# ───────────────────────────────────────────────────────────────────────────

# Slack notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_CHANNEL=#spx500-alerts

# Email alerts (via SendGrid)
# SENDGRID_API_KEY=your_sendgrid_api_key
# ALERT_EMAIL_FROM=alerts@yourcompany.com
# ALERT_EMAIL_TO=you@yourcompany.com

# SMS alerts (via Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+11234567890
# TWILIO_TO_NUMBER=+10987654321

# ───────────────────────────────────────────────────────────────────────────
# TIMEZONE & LOCATION
# ───────────────────────────────────────────────────────────────────────────

# Primary timezone for market data
TIMEZONE=America/New_York
# All timestamps stored in UTC, converted for display

# Market calendar
MARKET_CALENDAR=NYSE
# Options: NYSE, NASDAQ, CBOE (uses pandas_market_calendars)

# ───────────────────────────────────────────────────────────────────────────
# PERFORMANCE & COMPUTE
# ───────────────────────────────────────────────────────────────────────────

# Number of CPU cores for parallel processing
NUM_WORKERS=4
# Set to -1 to use all available cores

# Memory limits (in GB)
MAX_MEMORY_GB=16
# Kill process if exceeds this limit

# Batch size for data processing
BATCH_SIZE=10000
# Number of rows to process at once

# ───────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS (PHASE-GATED)
# ───────────────────────────────────────────────────────────────────────────

ENABLE_REAL_TIME_STREAMING=false
# Phase 7+: Enable WebSocket streaming

ENABLE_ML_MODELS=false
# Phase 4+: Enable machine learning models

ENABLE_LIVE_TRADING=false
# Phase 8+: Enable live order execution (DANGEROUS!)

ENABLE_CLOUD_STORAGE=false
# Phase 7+: Enable S3/cloud storage

# ───────────────────────────────────────────────────────────────────────────
# SECURITY
# ───────────────────────────────────────────────────────────────────────────

# JWT secret for API authentication (Phase 7+)
# JWT_SECRET=your_very_long_random_secret_key_here_min_32_chars

# API rate limiting
# API_RATE_LIMIT=100  # requests per minute

# Enable request logging
# LOG_API_REQUESTS=true

# ───────────────────────────────────────────────────────────────────────────
# NOTES
# ───────────────────────────────────────────────────────────────────────────
#
# 1. All API keys should be kept secret and never committed to git
# 2. Use strong, unique secrets for production environments
# 3. Rotate API keys regularly (every 90 days recommended)
# 4. Monitor API usage to avoid hitting rate limits
# 5. Enable MFA on all accounts that support it
# 6. For production, use a secrets manager (AWS Secrets Manager, HashiCorp Vault)
#
# ═══════════════════════════════════════════════════════════════════════════
